{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/openmymind/repo2mmd/schemas/repo2mmd-schema.json",
  "title": "Repo2MMD Intermediate Representation",
  "description": "Complete JSON schema for repository analysis IR generated by repo2mmd",
  "type": "object",
  "required": [
    "schema_version",
    "graph",
    "manifest",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Version of the IR schema",
      "minimum": 1,
      "maximum": 1
    },
    "graph": {
      "$ref": "#/definitions/graph"
    },
    "manifest": {
      "$ref": "#/definitions/graph_manifest"
    },
    "diagnostics": {
      "type": "array",
      "description": "Array of diagnostic objects",
      "items": {
        "$ref": "#/definitions/full_diagnostic"
      }
    }
  },
  "definitions": {
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "description": "Array of node objects sorted by ID",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "edges": {
          "type": "array",
          "description": "Array of edge objects sorted by (src, dst, rel)",
          "items": {
            "$ref": "#/definitions/edge"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "lang",
        "kind",
        "name",
        "fqname",
        "file",
        "range",
        "visibility",
        "origin_plugin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the node (hash)"
        },
        "lang": {
          "type": "string",
          "description": "Programming language",
          "enum": ["zig", "c", "ts", "javascript", "python", "rust", "go", "java"]
        },
        "kind": {
          "type": "string",
          "description": "Type of node",
          "enum": ["module", "file", "type", "func", "var"]
        },
        "name": {
          "type": "string",
          "description": "Display name of the node"
        },
        "fqname": {
          "type": "string",
          "description": "Fully qualified name"
        },
        "file": {
          "type": "string",
          "description": "File path or ID"
        },
        "range": {
          "$ref": "#/definitions/range"
        },
        "signature": {
          "type": "string",
          "description": "Optional signature for functions/types"
        },
        "visibility": {
          "type": "string",
          "description": "Visibility level",
          "enum": ["public", "private", "package"]
        },
        "origin_plugin": {
          "type": "string",
          "description": "Plugin that created this node"
        },
        "module_id": {
          "type": "string",
          "description": "Optional module identifier"
        },
        "tags": {
          "type": "array",
          "description": "Optional tags",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "src",
        "dst",
        "rel",
        "certainty"
      ],
      "properties": {
        "src": {
          "type": "string",
          "description": "ID of the source node"
        },
        "dst": {
          "type": "string",
          "description": "ID of the destination node"
        },
        "rel": {
          "type": "string",
          "description": "Relationship type",
          "enum": ["imports", "includes", "calls", "contains", "extends", "implements"]
        },
        "certainty": {
          "type": "string",
          "description": "Certainty level",
          "enum": ["static", "indirect", "dynamic", "comptime", "unknown"]
        },
        "certainty_reason": {
          "type": "string",
          "description": "Optional reason for certainty level"
        },
        "evidence_paths": {
          "type": "array",
          "description": "File paths providing evidence",
          "items": {
            "type": "string"
          }
        },
        "evidence_lines": {
          "type": "array",
          "description": "Line numbers providing evidence",
          "items": {
            "type": "integer"
          }
        },
        "diagnostics": {
          "type": "array",
          "description": "Diagnostic references",
          "items": {
            "$ref": "#/definitions/diagnostic_ref"
          }
        }
      }
    },
    "range": {
      "type": "object",
      "required": ["l0", "c0", "l1", "c1"],
      "properties": {
        "l0": {
          "type": "integer",
          "description": "Start line (1-based)"
        },
        "c0": {
          "type": "integer",
          "description": "Start column (1-based)"
        },
        "l1": {
          "type": "integer",
          "description": "End line (1-based)"
        },
        "c1": {
          "type": "integer",
          "description": "End column (1-based)"
        }
      }
    },
    "diagnostic_ref": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Diagnostic identifier"
        }
      }
    },
    "graph_manifest": {
      "type": "object",
      "required": [
        "generated_at",
        "generator_version",
        "graph_type",
        "input_root",
        "schema_version",
        "node_count",
        "edge_count",
        "unresolved_refs",
        "cache_hits",
        "cache_misses",
        "plugins_used"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "description": "Timestamp when generated"
        },
        "generator_version": {
          "type": "string",
          "description": "Version of repo2mmd"
        },
        "graph_type": {
          "type": "string",
          "description": "Type of graph analysis",
          "enum": ["Deps", "Call", "Type", "Include"]
        },
        "input_root": {
          "type": "string",
          "description": "Root directory analyzed"
        },
        "schema_version": {
          "type": "integer",
          "description": "IR schema version"
        },
        "node_count": {
          "type": "integer",
          "description": "Number of nodes",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "description": "Number of edges",
          "minimum": 0
        },
        "unresolved_refs": {
          "type": "integer",
          "description": "Number of unresolved references",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "description": "Cache hits",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "description": "Cache misses",
          "minimum": 0
        },
        "plugins_used": {
          "type": "array",
          "description": "Plugins used in analysis",
          "items": {
            "$ref": "#/definitions/plugin_summary"
          }
        },
        "cli_args": {
          "type": "array",
          "description": "CLI arguments used",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plugin_summary": {
      "type": "object",
      "required": ["id", "version", "schema_min", "schema_max"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Plugin identifier"
        },
        "version": {
          "type": "string",
          "description": "Plugin version"
        },
        "schema_min": {
          "type": "integer",
          "description": "Minimum schema version supported"
        },
        "schema_max": {
          "type": "integer",
          "description": "Maximum schema version supported"
        }
      }
    },
    "full_diagnostic": {
      "type": "object",
      "required": ["id", "severity", "code", "message"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Diagnostic identifier"
        },
        "severity": {
          "type": "string",
          "description": "Severity level",
          "enum": ["info", "warn", "error"]
        },
        "code": {
          "type": "string",
          "description": "Diagnostic code"
        },
        "message": {
          "type": "string",
          "description": "Diagnostic message"
        },
        "file": {
          "type": "string",
          "description": "Optional file path"
        },
        "range": {
          "$ref": "#/definitions/range"
        },
        "plugin": {
          "type": "string",
          "description": "Optional plugin identifier"
        }
      }
    }
  }
}